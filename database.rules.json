{
  "rules": {
    ".read": false,
    ".write": false,

    // 在線狀態 / 心跳：只能寫自己
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // 在線狀態：active(前景) / background(背景、鎖屏) / exited(已結束 App)
    // 只能寫自己；不開放讀取，由 Cloud Function 同步到 Redis 供雷達使用
    "presence": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'at'])",
        "state": { ".validate": "newData.val() === 'active' || newData.val() === 'background' || newData.val() === 'exited'" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    // 集會：只由 Cloud Function（geo-service 的 gathering）寫入
    // 活動本身與公告：登入者都能讀（App 依自己的稱呼與位置判斷是否參加）
    "gatherings": {
      ".read": "auth != null",
      ".indexOn": ["status", "emojiKey"]
    },
    "gatheringAnnouncements": {
      "$gid": { ".read": "auth != null", ".indexOn": ["at"] }
    },
    // 集會檢舉的人工審查標記：只有 Cloud Function 與主控台讀寫
    "gatheringReview": { ".read": false, ".write": false },
    // 全場提問的比例：只有主持人看得到；主持人看不到任何人的回答內容與身分
    "gatheringTally": {
      "$gid": { ".read": "auth != null && root.child('gatherings/' + $gid + '/hostUid').val() === auth.uid" }
    },
    // 自己回答過沒有：只能讀自己的
    "gatheringAnswers": {
      "$gid": { "$qid": { "$uid": { ".read": "auth != null && auth.uid === $uid" } } }
    },
    // 交棒邀請：只有被邀請的人讀得到自己的邀請（由 Cloud Function 寫入）
    "gatheringHandoffs": {
      ".indexOn": ["gid"],
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    // 交棒紀錄：只有 Cloud Function 與主控台讀寫（處理檢舉用）
    "gatheringHandoffLog": { ".read": false, ".write": false },
    "hosting": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    // 公開暱稱：所有登入者可讀，只能寫自己
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "nickname": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "$other": { ".validate": false }
      }
    },

    // 大頭貼網址：只接受 Firebase Storage 的網址
    "user_avatars": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 1024 && newData.val().beginsWith('https://firebasestorage.googleapis.com/')"
      }
    },

    // 敲門：發送者只能寫 pending 或收回；被敲者只能回覆 accepted / rejected 或略過
    "requests": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$senderUid": {
          ".read": "auth != null && (auth.uid === $senderUid || auth.uid === $targetUid)",
          ".write": "auth != null && ((auth.uid === $senderUid && $senderUid !== $targetUid && ( !newData.exists() || (newData.child('status').val() === 'pending' && !root.child('blocks/' + $targetUid + '/' + $senderUid).exists() && root.child('moderation/' + auth.uid + '/hidden').val() !== true))) || (auth.uid === $targetUid && ( !newData.exists() || newData.child('status').val() === 'accepted' || newData.child('status').val() === 'rejected' )))",
          "status": { ".validate": "newData.isString()" },
          "nickname": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "$other": { ".validate": false }
        }
      }
    },

    // 聊天室：roomId = 兩人 uid 排序後以 "_" 相接，只有房內兩人可讀寫
    "chats": {
      "$roomId": {
        ".read": "auth != null && ($roomId.beginsWith(auth.uid + '_') || $roomId.endsWith('_' + auth.uid))",
        ".write": "auth != null && ($roomId.beginsWith(auth.uid + '_') || $roomId.endsWith('_' + auth.uid))",
        "status": { ".validate": "newData.val() === 'active' || newData.val() === 'ended'" },
        "typing": {
          "$uid": { ".validate": "$uid === auth.uid && newData.isBoolean()" }
        },
        "messages": {
          "$msgId": {
            ".validate": "newData.hasChildren(['sender', 'text', 'timestamp']) && newData.child('sender').val() === auth.uid",
            "sender": { ".validate": "newData.isString()" },
            "senderName": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
            "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    // 推播 token：只有本人能讀寫（Cloud Functions 以 Admin 權限讀取）
    "tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length <= 4096"
      }
    },

    // 共鳴（一道微光）：resonance/{收到的人}/{送出的人} = 送出時間
    // 同一人 24 小時內只能送一次；被封鎖、被隱藏的人不能送；收到的人可讀、可清除自己的紀錄
    "resonance": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$senderUid": {
          ".write": "auth != null && ((auth.uid === $senderUid && $senderUid !== $targetUid && newData.exists() && (!data.exists() || data.val() < now - 86400000) && !root.child('blocks/' + $targetUid + '/' + $senderUid).exists() && root.child('moderation/' + auth.uid + '/hidden').val() !== true) || (auth.uid === $targetUid && !newData.exists()))",
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
        }
      }
    },

    // 共鳴推播的節流紀錄（只由 Cloud Functions 寫入）
    "resonancePush": {
      "$uid": { ".read": false }
    },

    // 檢舉：只能以自己的名義新增、送出後不可修改；一般使用者不能讀取任何檢舉
    "reports": {
      ".indexOn": ["target"],
      "$reportId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['reporter', 'target', 'reason', 'context', 'at'])",
        "reporter": { ".validate": "newData.val() === auth.uid" },
        "target": { ".validate": "newData.isString() && newData.val() !== auth.uid && newData.val().length > 0 && newData.val().length <= 128" },
        "reason": { ".validate": "newData.val() === 'harassment' || newData.val() === 'sexual' || newData.val() === 'scam' || newData.val() === 'hate' || newData.val() === 'impersonation' || newData.val() === 'other'" },
        "detail": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "context": { ".validate": "newData.val() === 'bubble' || newData.val() === 'knock' || newData.val() === 'chat' || newData.val() === 'whisper' || newData.val() === 'gathering'" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    // 審核狀態：只由後台（Cloud Functions 或你在 Firebase 主控台）寫入；本人可讀
    "moderation": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    // 同意條款的紀錄（審核時可佐證使用者已同意）
    "consents": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['version', 'at'])",
        "version": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "blockedBy": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$senderUid": {
          ".write": "auth != null && auth.uid === $senderUid",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
